{
  "version": "0.2.0-forge",
  "lattice": {
    "heartbeat_ms": 90,
    "resonance_threshold": 0.71,
    "max_shards": 256
  },
  "crucible": {
    "default_distortion": "fold",
    "temperature_range": [0.2, 1.4],
    "flux_stability": 0.68
  },
  "choir": {
    "agents": ["seraph_alpha", "seraph_beta", "seraph_gamma", "seraph_void"],
    "consensus": "harmonic_majority",
    "void_weight": 0.22
  },
  "shell": {
    "reality_mode": "layered",
    "boot_sequence": ["lattice", "crucible", "choir"]
  },
  "worlds": {
    "default_seed": "worlds/seeds/seed_01.world",
    "allow_collapse": true
  }
}
